# Copied to /opt/jellyfin/sites/files.caddy by scripts/05-setup-uploads.sh (FILES_DOMAIN replaced).
# Needs its own DNS name pointing at the server, e.g. files.example.com.
FILES_DOMAIN_PLACEHOLDER {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	# Public: the catalogue app (meta tells the page who is looking: public, member, uploader, admin), its API, sign-in, SEO files.
	# Only the file server (dufs: listings, uploads, downloads) stays behind the staff sign-in.
	@public path /login /auth/* /_lib/* /robots.txt /sitemap.xml /sitemap-*.xml /llms.txt /favicon.ico /manifest.webmanifest /sw.js /pwa/*
	handle @public {
		reverse_proxy uploads-meta:8000
	}
	handle /_meta/* {
		reverse_proxy uploads-meta:8000
	}
	@page {
		method GET
		header Accept *text/html*
		path / /index.html /catalogue /catalogue/* /title/* /profiles /settings /privacy */
	}
	handle @page {
		reverse_proxy uploads-meta:8000
	}
	handle {
		route {
			forward_auth uploads-meta:8000 {
				uri /auth/check
				copy_headers X-Role
			}
			# Big files: no body limit and long timeouts for slow connections (uploads are sent in 16 MB chunks).
			reverse_proxy uploads:5000 {
				transport http {
					read_timeout 10m
					write_timeout 10m
				}
			}
		}
	}
}

# Optional: when the app lives on the bare domain, send the old names there (path and query kept).
# files.example.com, www.example.com {
#	redir https://example.com{uri} permanent
# }
