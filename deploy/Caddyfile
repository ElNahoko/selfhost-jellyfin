# Cloudflare in front of the site (see docs/14-cloudflare.md): trust its addresses so every visitor's real IP is seen
# (sign-in and contact limits use it). Harmless without Cloudflare: no request comes from these ranges then.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$JELLYFIN_DOMAIN} {
	# No compression: video is already compressed and this saves CPU on a small server.

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# The web client's files carry a content hash in their name (44184.df71....chunk.js), so they can be cached
	# for a year: the browser stops re-checking dozens of them on every start. A new Jellyfin version = new names.
	@hashed path_regexp ^/web/[A-Za-z0-9_.-]+\.[0-9a-f]{16,24}\.(chunk\.js|css|woff2?|ttf|svg|png|jpg|webp)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Caddy forwards X-Forwarded-For / -Proto / -Host automatically and handles websockets.
	# Optional self-hosted theme files (see docs/12-theme.md). Harmless if the folder is empty.
	# TVs (LG webOS, Samsung Tizen, ...) have an old browser and a remote control instead of a mouse, so they get
	# plain stock Jellyfin: every theme file is answered with an empty one. Phones, tablets and computers get the theme.
	@tv header_regexp tv User-Agent (Web0S|webOS|Tizen|SMART-TV|SmartTV|NetCast|HbbTV|JellyfinDesktop|JellyfinMediaPlayer)
	handle /theme/* {
		header Cache-Control "no-cache"
		handle @tv {
			handle /theme/*.js {
				header Content-Type "application/javascript"
				respond "/* TV: stock Jellyfin */" 200
			}
			handle {
				header Content-Type "text/css"
				respond "/* TV: stock Jellyfin */" 200
			}
		}
		handle {
			root * /srv
			file_server
		}
	}
	handle {
		reverse_proxy jellyfin:8096
	}
}

# Optional extra sites (for example the upload page). Does nothing if the folder is empty.
import /etc/caddy/sites/*.caddy
