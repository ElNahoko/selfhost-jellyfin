# Copy to .env and edit. This file holds no secrets, but .env is git-ignored anyway.

# Pin real, current stable tags (checked Oct 2026: Jellyfin 12.1, Caddy 2.11). Check https://github.com/jellyfin/jellyfin/releases and https://hub.docker.com/_/caddy
# Never use "latest" on a server you do not watch.
JELLYFIN_VERSION=12.1
CADDY_VERSION=2.11

# Your public hostname (must already point at the server's IP, A record).
JELLYFIN_DOMAIN=media.example.com

# Run Jellyfin as the same user that uploads media (run `id -u && id -g` as that user).
PUID=1000
PGID=1000

TZ=Europe/Paris

# Only if you enable the optional upload page (scripts/05-setup-uploads.sh)
FILEBROWSER_VERSION=v2.63.23
