# Copy to .env and edit. This file holds no secrets, but .env is git-ignored anyway.

# Pin real, current stable tags. Check https://github.com/jellyfin/jellyfin/releases and https://hub.docker.com/_/caddy
# Never use "latest" on a server you do not watch.
JELLYFIN_VERSION=10.10.7
CADDY_VERSION=2.10

# Your public hostname (must already point at the server's IP, A record).
JELLYFIN_DOMAIN=media.example.com

# Run Jellyfin as the same user that uploads media (run `id -u && id -g` as that user).
PUID=1000
PGID=1000

TZ=Europe/Paris
